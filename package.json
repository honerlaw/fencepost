{
  "name": "fencepost",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/kalam": "^0.4.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@tamagui/config": "2.7.7",
    "ai": "^7.0.157",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-server": "~58.0.6",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.20",
    "express": "^5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tamagui": "2.7.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@onerlaw/agentic-eslint-plugin": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@tamagui/metro-plugin": "2.7.7",
    "@types/express": "^5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.3",
    "eslint-plugin-regexp": "^3.3.2",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "65",
    "eslint-plugin-vibe-proof": "1.10.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "lockfile-lint": "^5.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "type-coverage": "^2.31.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "dev": "doppler run --project fencepost --config prd -- expo start",
    "serve": "doppler run --project fencepost --config prd -- node server.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "brand:render": "tsx scripts/brand/render-assets.ts",
    "build:web": "expo export --platform web",
    "e2e": "expo export --platform web && playwright test",
    "cards:eval": "doppler run --project fencepost --config prd -- tsx scripts/cards-eval.ts",
    "stub:openrouter": "node scripts/stub-openrouter.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --project scripts/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard": "tsx scripts/guardrails/run-guard.ts",
    "guard:security": "gitleaks git --no-banner --redact --config .gitleaks.toml && uvx semgrep@1.183.0 scan --config .semgrep --error --metrics off --quiet",
    "test:coverage": "vitest run --coverage",
    "prepare": "node -e \"if(process.env.CI||!require('fs').existsSync('.git'))process.exit(0);try{require('child_process').execSync('lefthook install',{stdio:'inherit'})}catch{console.warn('lefthook not installed: skipping git hooks')}\""
  },
  "private": true,
  "overrides": {
    "glob": "14.0.3",
    "@expo/fingerprint": {
      "minimatch": "11.0.3"
    },
    "@tamagui/static": {
      "esbuild": "0.28.1"
    }
  }
}
